server {
    listen ${PORT};
    listen [::]:${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Same-origin API: the browser never talks to the backend directly, so no CORS in production.
    location /api/ {
        # Resolve per request (not once at startup) so backend redeploys with new IPs are picked up.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $upstream ${API_UPSTREAM};
        proxy_pass $upstream;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build assets can be cached forever.
    location ~* \.(?:js|css|woff2?|svg|png|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
